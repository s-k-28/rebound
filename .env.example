BASE_SEPOLIA_RPC=https://sepolia.base.org
ARC_TESTNET_RPC=https://rpc.testnet.arc.network
CIRCLE_SANDBOX_URL=https://iris-api-sandbox.circle.com
REBOUND_DB=data/rebound.sqlite3
# QuickNode webhook destination Security token.
REBOUND_STREAM_SECURITY_TOKEN=
# Optional shared header for local adapter checks. The Security token takes precedence.
REBOUND_STREAM_SECRET=
# Optional. Public address prefilled by the QuickNode walkthrough. Defaults to the throwaway
# testnet wallet in docs/LIVE-RECOVERY.md. Never put a private key here.
REBOUND_QUICKNODE_DEMO_WALLET=
